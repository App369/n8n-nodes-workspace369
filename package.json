{
	"name": "n8n-nodes-workspace369",
	"version": "0.1.0",
	"description": "n8n community nodes for Workspace369: manage clients, requests, invoices and calendar events, and start workflows on instant events.",
	"license": "MIT",
	"homepage": "https://github.com/App369/n8n-nodes-workspace369#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"workspace369",
		"crm",
		"invoicing"
	],
	"author": {
		"name": "App369",
		"email": "support@workspace369.com",
		"url": "https://workspace369.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/App369/n8n-nodes-workspace369.git"
	},
	"bugs": {
		"url": "https://github.com/App369/n8n-nodes-workspace369/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/Workspace369Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Workspace369/Workspace369.node.js",
			"dist/nodes/Workspace369Trigger/Workspace369Trigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
